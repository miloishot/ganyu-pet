# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit it.
# Everything here is OPTIONAL: with no `.env.local` at all the pet still runs,
# reacts to hooks and wanders. It just won't talk, and nothing leaves the machine.

# --- Brain (speech + chat) -----------------------------------------------
# Which protocol the endpoint speaks. Leave it out for the default.
#   openai       OpenAI Responses API (/v1/responses) — the default
#   openai-chat  any chat-completions server (/v1/chat/completions):
#                OpenRouter, DeepSeek, LM Studio, ...
#   anthropic    Anthropic Messages API (/v1/messages)
#   ollama       local Ollama: no key needed, base URL defaults to
#                http://127.0.0.1:11434
# Anything else turns the brain off, with the valid names logged.
# GANYU_BRAIN_PROVIDER=openai
#
# The same three keys serve every provider. The base URL goes WITHOUT /v1 —
# the route adds it. All three are required (ollama needs only the model); miss
# one and the brain stays off with a reason logged.
GANYU_OPENAI_BASE_URL=https://api.openai.com
GANYU_OPENAI_MODEL=<model-id>
GANYU_OPENAI_API_KEY=

# Reasoning effort. openai defaults to low; the others send none unless set.
# none omits the field.
# GANYU_OPENAI_REASONING_EFFORT=low

# openai only: answer from /v1/chat/completions when the endpoint has no /v1/responses.
# Default OFF. Turn it on for an ordinary OpenAI-compatible server; leave it off
# on a proxy that injects its own system prompt, or you get a coding agent in a
# Ganyu hat.
# GANYU_ALLOW_CHAT_FALLBACK=1

# --- Speech to text (push-to-talk) ---------------------------------------
# Needs an endpoint that actually serves /v1/audio/transcriptions — many
# OpenAI-compatible proxies do not. Leave the key blank to disable listening.
GANYU_STT_BASE_URL=https://api.openai.com/v1
GANYU_STT_MODEL=gpt-4o-transcribe
GANYU_STT_API_KEY=

# --- What she is allowed to see ------------------------------------------
# All three DEFAULT ON, and only matter once a brain key is set — they govern
# what travels to your endpoint. Set to 0 (or false/no/off) to turn one off.
#
#   GANYU_SEE_PROMPTS    the text you typed to your coding agent
#   GANYU_READ_SESSIONS  past session transcripts, through an allowlist that
#                        passes assistant prose and your own asks — never a tool
#                        input, tool result, thinking block or attachment
#   GANYU_MEMORY_SEARCH  her own ledger, looked up mid-answer rather than
#                        recited from a digest
#
# GANYU_SEE_PROMPTS=0
# GANYU_READ_SESSIONS=0
# GANYU_MEMORY_SEARCH=0

# --- Debug ---------------------------------------------------------------
# GANYU_DEBUG=1
# GANYU_DEVTOOLS=1
# GANYU_PORT=47821
# GANYU_NO_GPU=1
